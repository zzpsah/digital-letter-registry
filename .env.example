# Runtime configuration names only. Never commit real values.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_ACCESS_TOKEN=runtime_user_access_token
SUPABASE_OWNER_ID=00000000-0000-4000-8000-000000000000

# Private storage identifiers remain runtime-only and are never committed.
# DRIVE_ORIGINALS_FOLDER_REFERENCE=runtime_private_reference


# Replaceable document-understanding provider.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=runtime_only_key


# Semantic search embeddings.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
