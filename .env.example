# Runtime configuration names only. Never commit real values.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_ACCESS_TOKEN=runtime_user_access_token
SUPABASE_OWNER_ID=00000000-0000-4000-8000-000000000000

# Optional Supabase Management API token used only by the guarded hosted-Auth
# configuration helper. Prefer a scoped PAT with auth-config permissions.
# Never commit a real token.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=runtime_only_management_token

# Private storage identifiers remain runtime-only and are never committed.
# DRIVE_ORIGINALS_FOLDER_REFERENCE=runtime_private_reference


# Replaceable document-understanding provider.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=runtime_only_key


# Semantic search embeddings.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768


# Passwordless auth redirect. Must also be allowlisted in Supabase Auth.
AUTH_REDIRECT_URL=https://archive.example.com/auth/confirm
AUTH_COOKIE_SECURE=true
# Persistent signed-in session cookie lifetime; default is 30 days.
# Allowed range: 86400 (1 day) to 7776000 (90 days).
AUTH_REFRESH_COOKIE_MAX_AGE=2592000
# Optional explicit same-origin CSRF boundary; otherwise derived from AUTH_REDIRECT_URL.
AUTH_APP_ORIGIN=https://archive.example.com


# Short-lived private Google Drive OAuth token used only by the server-side
# original-file reader. Never expose this value to the browser or commit it.
GOOGLE_DRIVE_ACCESS_TOKEN=runtime_only_short_lived_token


# Preferred long-running Google Drive OAuth configuration.
# Inject these three values at process start from the approved secret manager.
# Do not commit them or persist them in application logs.
GOOGLE_OAUTH_CLIENT_ID=runtime_only_client_id
GOOGLE_OAUTH_CLIENT_SECRET=runtime_only_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=runtime_only_refresh_token

# Optional local/migration fallback only. Production/private-server runtimes may
# use a protected authorized-user file while transitioning to secret injection.
GOOGLE_OAUTH_CREDENTIALS_FILE=/private/runtime/google-authorized-user.json

# GOOGLE_DRIVE_ACCESS_TOKEN remains an optional short-lived development fallback.
