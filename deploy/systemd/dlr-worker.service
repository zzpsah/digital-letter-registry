[Unit]
Description=Digital Letter Registry one-job processing worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/prashant/.local/bin/dlr-worker-run-with-bitwarden
WorkingDirectory=/home/prashant/projects/digital-letter-registry
NoNewPrivileges=true
PrivateTmp=true
# OCRmyPDF is capped at 40 minutes; leave five minutes for queue finalization.
TimeoutStartSec=2700
TimeoutStopSec=30
