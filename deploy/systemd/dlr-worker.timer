# Queue recovery consumer for jobs not dispatched by the WhatsApp event path.
# The WhatsApp event path may invoke the same worker immediately; shared flock
# guarantees that only one OCR worker runs at a time.
[Unit]
Description=Run Digital Letter Registry queue worker after boot and after each completed job

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
AccuracySec=10s
Persistent=true
Unit=dlr-worker.service

[Install]
WantedBy=timers.target
